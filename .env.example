# Copy to .env (gitignored) and fill in. Provisioning is a human task:
# tab-pinyinizer-ilg.14.
#
# The timestamp pipeline spends real money, so both keys are optional for every
# offline stage (normalize, align against a cached asr.json, emit, verify) and
# only required by the provider stage.

# ElevenLabs forced alignment (POST /v1/forced-alignment): the primary timing
# source, because it returns per-character times plus a per-token loss and
# Chinese is supported. Billed at Scribe rates, US$0.22 per audio hour.
ELEVENLABS_API_KEY=

# OpenAI whisper-1 word timestamps: independent corroboration of the ElevenLabs
# pass, not a second attempt at the text. ~US$0.006 per audio minute.
OPENAI_API_KEY=
